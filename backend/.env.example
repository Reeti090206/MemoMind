# MeetGraph API Configuration Example
# Rename this file to .env and populate with your credentials.
# The backend uses these keys to connect to live AI services.

# 1. OpenAI API Key (Required for live transcription via Whisper & intelligence extraction via GPT models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2. Hugging Face Hub token (Optional, used to authorize/accelerate SentenceTransformers local downloads)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# 3. Production Database URL (Optional, defaults to SQLite local database file 'meetgraph.db')
# e.g., postgresql://user:password@localhost:5432/meetgraph
DATABASE_URL=

# 4. Email Configuration
SENDER_EMAIL=reetikhandelwal09@gmail.com
# SMTP settings for sending real welcome emails (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=reetikhandelwal09@gmail.com
# SMTP_PASSWORD=your_app_password_here

