# ============================================================
# MemoMind / MeetGraph — Root .gitignore
# ============================================================

# ── Secrets & Environment ──────────────────────────────────
.env
.env.*
!*.example
!**/*.example


# ── Python / Backend ──────────────────────────────────────
backend/.venv/
backend/venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# SQLite databases (auto-generated by run.py)
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Uploaded audio/video files (user data, not source)
backend/uploads/

# ── Node / Frontend ───────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Yarn
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/.pnp.*

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS & Editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.pem
.idea/
.vscode/settings.json
*.swp
*.swo
