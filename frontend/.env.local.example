# MemoMind Frontend Configuration
# Rename this file to .env.local and populate with your credentials.

# 1. Clerk Authentication Keys (Optional, wraps pages with native secure login)
# Get your keys from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Clerk Route Redirect Config
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# 2. FastAPI Backend Service API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# 3. Google OAuth Credentials (Required for custom Google SSO authentication)
# Get your credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
